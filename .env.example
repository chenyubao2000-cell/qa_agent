# ── QA 工作空间，脚本生成和运行以及报告分析的根目录 ──────────────────────────────
QA_WORKSPACE_DIR=./tests/e2e/mira-test
# QA_WORKSPACE_DIR="./tests/e2e/local"
# QA_WORKSPACE_DIR="./cases"
# 源码目录（读源码用，默认同 QA_WORKSPACE_DIR）
SOURCE_PROJECT_DIR="/path/to/your/source-project"
# SOURCE_PROJECT_DIR=../preview/mira
TARGET_GITHUB_URL=https://github.com/your-org/your-repo
TARGET_GITHUB_OWNER=your-org
TARGET_GITHUB_REPO=your-repo
TARGET_BRANCH=main

# ── 多语言测试（可选）──────────────────────────
# 逗号分隔的语言代码，设置后自动生成多 Playwright project（每语言一个）
# 不设置则单语言模式（默认 en-US）
APP_LANGUAGES=en
I18N_MESSAGES_DIR=./tests/e2e/mira_online/messages

# ── Preview 环境 ──────────────────────────────
PREVIEW_URL=https://your-preview-env.example.com/
# PREVIEW_URL=https://www.example.com/
# PREVIEW_URL=https://localhost:3000/

# ── 测试账号 ──────────────────────────────────
E2E_TEST_EMAIL=test@example.com
E2E_TEST_PASSWORD=changeme

# ── GitHub ───────────────────────────────────
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# ── Linear ───────────────────────────────────
LINEAR_API_KEY=your_linear_api_key
LINEAR_PROJECT_ID=your_linear_project_id
LINEAR_TEAM_ID=your_linear_team_id

POSTGRES_URL=postgres://user:password@host:port/dbname

# ── Playwright ───────────────────────────────
# PLAYWRIGHT_BASE_URL 不再单独维护，统一从 PREVIEW_URL 读取
PLAYWRIGHT_HEADLESS=true

# ── 通知（可选）──────────────────────────────
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# ── Tool Probe (/qa-tool-probe) ───────────────
# 跑 judge.ts 时使用，shell 出去调本地 claude -p CLI
JUDGE_LANG=zh                       # zh|en，judge 输出 reason 的语言
CLAUDE_JUDGE_CONCURRENCY=1          # 并发 claude -p 子进程数
CLAUDE_JUDGE_TIMEOUT=240            # 单次 judge 调用超时（秒）
