    "preconditions": ["已登录", "已打开 /settings/connectors 列表"],
    "setup": [{ "type": "navigate", "action": "navigate", "pomMethod": "goto" }],
    "teardown": [{ "type": "cleanup", "action": "close popup + reload list", "reason": "reset pending/disabled Connect button state without completing OAuth" }],
    "uiElements": [
      { "role": "button", "name": "Connect Outlook", "action": "click+capture-popup", "locatorHint": "getByRole('button', { name: 'Connect Outlook' })", "i18nKey": "settings.connectors.connect" }
    ],
    "assertions": [
      { "type": "matches", "selector": "popup url", "target": "OAuth popup host", "expected": "login.microsoftonline.com or composio.dev" },
