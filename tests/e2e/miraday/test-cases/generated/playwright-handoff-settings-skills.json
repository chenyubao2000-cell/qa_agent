[
  {
    "id": "TC-CDP-SKILL-001",
    "storyId": "settings-skills-official-list",
    "title": "技能页默认加载，Official tab 渲染官方技能列表及启用开关（数量与 tab 计数徽标一致）",
    "priority": "P0",
    "preconditions": ["已登录（storageState）"],
    "setup": [
      { "type": "navigate", "action": "navigate", "pomMethod": "goto" }
    ],
    "teardown": [],
    "notes": "官方技能数量属环境相关的内容/配置差异（非 locator 问题）：生产环境（https://mira.day/settings/skills）实测为 4 个（skill-creator, talent-mapping, salary-report, candidate-summary），原 Railway preview 环境为 5 个。断言改为读取 tab 计数徽标（'Official {N}'）与实际渲染行数做一致性校验，不再硬编码具体数量或技能名列表。",
    "uiElements": [
      { "role": "heading", "name": "All Skills", "i18nKey": "settings.skills.title", "locatorHint": "getByRole('heading', { level: 1, name: 'All Skills' })", "action": null },
      { "role": "tab", "name": "Official", "i18nKey": "settings.skills.tabs.official", "locatorHint": "getByRole('tab', { name: /Official/ })", "action": null },
      { "role": "switch", "name": "Enable or disable {first rendered official skill}", "i18nKey": "settings.skills.toggleAriaLabel", "locatorHint": "skillsPage.skillSwitch(await skillsPage.firstOfficialSkillName())", "action": null }
    ],
    "assertions": [
      { "type": "text", "target": "h1 heading", "selector": "heading", "name": "All Skills", "expected": "All Skills", "i18nKey": "settings.skills.title" },
      { "type": "visible", "target": "Official tab selected", "selector": "tab", "expected": null, "i18nKey": "settings.skills.tabs.official" },
      { "type": "count", "target": "skill toggle switches matches Official tab count badge", "selector": "switch", "expected": "dynamic: parsed from Official tab accessible name (prod = 4)", "i18nKey": null },
      { "type": "visible", "target": "first official skill switch checked+enabled", "selector": "switch", "expected": null, "i18nKey": null }
    ]
  },
  {
    "id": "TC-CDP-SKILL-002",
