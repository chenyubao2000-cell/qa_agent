  {
    "id": "TC-CDP-SKILL-005",
    "storyId": "settings-skills-official-list",
    "title": "官方技能行不可点击（渲染为文本而非按钮），开关可用",
    "priority": "P2",
    "preconditions": ["已登录", "Official tab"],
    "setup": [
      { "type": "navigate", "action": "navigate", "pomMethod": "goto" }
    ],
    "teardown": [],
    "notes": "改用 skillsPage.firstOfficialSkillName() 动态获取当前渲染的第一个官方技能名（从其 switch 的 aria-label 反解），不再硬编码 'mira-candidate-profile'（该技能在生产环境不存在）。生产环境实测第一个官方技能为 skill-creator。",
    "uiElements": [
      { "role": "text", "name": "{first rendered official skill}", "i18nKey": null, "locatorHint": "getByText(await skillsPage.firstOfficialSkillName(), { exact: true })", "action": null },
      { "role": "switch", "name": "Enable or disable {first rendered official skill}", "i18nKey": "settings.skills.toggleAriaLabel", "locatorHint": "skillsPage.skillSwitch(await skillsPage.firstOfficialSkillName())", "action": null }
    ],
    "assertions": [
      { "type": "count", "target": "no button named after official skill (source='system' non-clickable branch)", "selector": "button", "name": "{first rendered official skill}", "expected": 0, "i18nKey": null },
      { "type": "visible", "target": "official skill name text", "selector": "text", "expected": null, "i18nKey": null },
      { "type": "enabled", "target": "official skill toggle enabled", "selector": "switch", "expected": null, "i18nKey": null }
    ]
  }
]
