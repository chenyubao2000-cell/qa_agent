      { "role": "tab", "name": "Personal", "i18nKey": "settings.skills.tabs.personal", "locatorHint": "getByRole('tab', { name: /Personal/ })", "action": "click" },
      { "role": "text", "name": "You haven't created any skills yet", "i18nKey": "settings.skills.empty.personal.title", "locatorHint": "getByText(/You haven't created any skills yet/)", "action": null },
      { "role": "button", "name": "Create your first skill", "i18nKey": "settings.skills.empty.personal.cta", "locatorHint": "getByRole('button', { name: 'Create your first skill' })", "action": null }
    ],
    "assertions": [
      { "type": "visible", "target": "Personal empty-state title", "selector": "text", "expected": null, "i18nKey": "settings.skills.empty.personal.title" },
      { "type": "visible", "target": "Create your first skill CTA", "selector": "button", "expected": null, "i18nKey": "settings.skills.empty.personal.cta" },
      { "type": "url", "target": "URL reflects personal tab", "selector": null, "expected": "/tab=personal/", "i18nKey": null }
    ]
  },
  {
    "id": "TC-CDP-SKILL-003",
    "storyId": "settings-skills-new-menu",
