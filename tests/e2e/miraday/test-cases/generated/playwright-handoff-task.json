    "title": "已登录用户打开 Task 首页看到欢迎语与输入框",
    "priority": "P0",
    "preconditions": ["已登录（默认 storageState）"],
    "setup": [{ "type": "navigate", "action": "navigate", "pomMethod": "goto", "data": {} }],
    "teardown": [],
    "uiElements": [
      {
        "element": "welcome heading (h1)",
        "role": "heading",
        "name": "What can I do for you?",
        "i18nKey": "dashboard.welcome",
        "locatorHint": "getByRole('heading', { name: 'What can I do for you?', level: 1 })",
        "action": null
      },
      {
        "element": "composer textbox (RichInput)",
        "role": "textbox",
        "name": null,
        "locatorHint": "getByRole('textbox')",
        "action": null
      },
      {
        "element": "submit button (PromptInputSubmit)",
        "role": "button",
        "name": "Submit",
        "locatorHint": "getByRole('button', { name: 'Submit' })",
        "action": null
      }
    ],
    "assertions": [
      { "type": "url", "selector": null, "expected": "/task", "note": "not redirected to /sign-in" },
      { "type": "text", "selector": "heading", "expected": "What can I do for you?", "i18nKey": "dashboard.welcome" },
      { "type": "visible", "selector": "textbox", "expected": null, "note": "composer visible" },
      { "type": "disabled", "selector": "button", "expected": null, "note": "Submit disabled on empty composer" }
    ]
  },
  {
    "id": "TC-CDP-TASK-002",
    "storyId": "task-index-composer",
    "title": "输入文本使 Submit 按钮启用",
    "priority": "P0",
    "preconditions": ["已登录，导航到 /task"],
    "setup": [{ "type": "navigate", "action": "navigate", "pomMethod": "goto", "data": {} }],
    "teardown": [],
    "uiElements": [
      {
        "element": "composer textbox (RichInput)",
        "role": "textbox",
        "name": null,
        "locatorHint": "getByRole('textbox')",
        "action": "fill",
        "value": "This is a smoke test draft."
      },
      {
        "element": "submit button (PromptInputSubmit)",
        "role": "button",
        "name": "Submit",
        "locatorHint": "getByRole('button', { name: 'Submit' })",
        "action": null
      }
    ],
    "assertions": [
      { "type": "disabled", "selector": "button", "expected": null, "note": "Submit disabled before typing" },
      { "type": "text", "selector": "textbox", "expected": "This is a smoke test draft.", "note": "composer shows typed text (contains)" },
      { "type": "enabled", "selector": "button", "expected": null, "note": "Submit enabled after non-empty text" }
    ]
  },
  {
    "id": "TC-CDP-TASK-003",
    "storyId": "task-index-composer",
    "title": "输入框空/非空边界切换 Submit 启用态",
    "priority": "P1",
    "preconditions": ["已登录，导航到 /task，输入框初始为空"],
    "setup": [{ "type": "navigate", "action": "navigate", "pomMethod": "goto", "data": {} }],
    "teardown": [],
    "uiElements": [
      {
        "element": "composer textbox (RichInput)",
        "role": "textbox",
        "name": null,
        "locatorHint": "getByRole('textbox')",
        "action": "fill",
        "value": "x"
      },
      {
        "element": "submit button (PromptInputSubmit)",
        "role": "button",
        "name": "Submit",
        "locatorHint": "getByRole('button', { name: 'Submit' })",
        "action": null
      }
    ],
    "assertions": [
      { "type": "disabled", "selector": "button", "expected": null, "note": "empty (0 chars) → disabled" },
      { "type": "enabled", "selector": "button", "expected": null, "note": "non-empty (>=1 char) → enabled" },
      { "type": "disabled", "selector": "button", "expected": null, "note": "cleared back to empty → disabled again" }
    ]
  },
