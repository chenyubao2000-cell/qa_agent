    "title": "编辑页在 edit 模式正确加载且初始 Save changes 禁用",
    "priority": "P0",
    "preconditions": ["已登录", "账户已配置 AI Twin profile"],
    "setup": [
      { "type": "navigate", "action": "navigate", "pomMethod": "goto", "data": {} }
    ],
    "uiElements": [],
    "assertions": [
      { "type": "visible", "selector": "heading", "name": "Edit your AI Twin", "i18nKey": "twin.hero.edit.title", "expected": null },
      { "type": "visible", "selector": "textbox", "name": "AI Twin name", "i18nKey": "twin.fields.name.label", "expected": null },
      { "type": "value-nonempty", "selector": "textbox", "name": "AI Twin name", "i18nKey": "twin.fields.name.label", "expected": null, "note": "编辑模式预填当前分身名，值应非空" },
      { "type": "disabled", "selector": "button", "name": "Save changes", "i18nKey": "twin.cta.edit.desktop", "expected": null, "note": "初始无字段 diff → submitDisabled" }
    ],
    "teardown": []
  },
  {
    "id": "TC-CDP-TWIN-002",
    "storyId": "STORY-TWIN-EDIT",
    "title": "修改名称为合法新值后 Save changes 由禁用变为启用",
    "priority": "P0",
    "preconditions": ["已登录", "账户已配置 AI Twin profile", "处于编辑页初始态"],
    "setup": [
      { "type": "navigate", "action": "navigate", "pomMethod": "goto", "data": {} }
    ],
    "uiElements": [
      { "role": "textbox", "name": "AI Twin name", "i18nKey": "twin.fields.name.label", "action": "fill", "dataType": "text", "dataVariant": "unique-valid-twin-name", "locatorHint": "getByLabel('AI Twin name')", "note": "合法且不同于当前名，≤20 codepoint，带时间戳保证唯一" }
    ],
    "assertions": [
      { "type": "enabled", "selector": "button", "name": "Save changes", "i18nKey": "twin.cta.edit.desktop", "expected": null, "note": "名称产生 diff 且 nameValid → 启用（不提交）" }
    ],
    "teardown": []
  },
  {
