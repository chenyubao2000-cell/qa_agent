[
  {
    "id": "TC-CDP-FP-001",
    "storyId": "forgot-password",
    "title": "匿名用户直接访问 /forgot-password 页面直出、无登录墙、表单完整渲染",
    "priority": "P0",
    "source": "cdp",
    "preconditions": [],
    "setup": [],
    "teardown": [],
    "uiElements": [
      { "action": "navigate", "target": "/forgot-password", "locatorHint": null }
    ],
    "assertions": [
      { "type": "url", "expected": "/forgot-password", "note": "pathname stays on /forgot-password, no login-wall redirect" },
      { "type": "visible", "selector": "heading", "name": "Forgot Password", "i18nKey": "auth.forgotPasswordTitle", "expected": null },
      { "type": "text", "selector": "heading", "name": "Forgot Password", "expected": "Forgot Password", "i18nKey": "auth.forgotPasswordTitle" },
      { "type": "visible", "target": "emailInput", "expected": null },
      { "type": "visible", "target": "submitButton", "expected": null },
      { "type": "enabled", "target": "submitButton", "expected": null },
      { "type": "visible", "target": "backToSignInLink", "expected": null }
    ]
  },
  {
    "id": "TC-CDP-FP-002",
    "storyId": "forgot-password",
    "title": "输入非法格式邮箱失焦后展示校验错误并置 aria-invalid",
    "priority": "P1",
    "source": "cdp",
    "preconditions": ["导航到 /forgot-password"],
    "setup": [{ "type": "navigate", "action": "navigate", "target": "/forgot-password" }],
    "teardown": [],
    "uiElements": [
      { "action": "fill", "target": "emailInput", "value": "not-an-email", "locatorHint": "getByLabel('Email')", "dataType": "text", "dataVariant": "invalid-email" },
      { "action": "blur", "target": "emailInput", "note": "blur by focusing submit button to trigger onBlur zod validation" }
    ],
    "assertions": [
      { "type": "visible", "target": "emailError", "expected": "Please enter a valid email address", "i18nKey": "auth.validation.emailInvalid" },
      { "type": "text", "target": "emailError", "expected": "Please enter a valid email address", "i18nKey": "auth.validation.emailInvalid" },
      { "type": "attribute", "target": "emailInput", "attribute": "aria-invalid", "expected": "true" }
    ]
  },
  {
    "id": "TC-CDP-FP-003",
    "storyId": "forgot-password",
    "title": "输入合法格式邮箱失焦后不展示错误且 aria-invalid 保持 false",
    "priority": "P1",
    "source": "cdp",
    "preconditions": ["导航到 /forgot-password"],
    "setup": [{ "type": "navigate", "action": "navigate", "target": "/forgot-password" }],
    "teardown": [],
    "uiElements": [
      { "action": "fill", "target": "emailInput", "value": "qa.user@example.com", "locatorHint": "getByLabel('Email')", "dataType": "contact", "dataVariant": "valid-email" },
      { "action": "blur", "target": "emailInput", "note": "blur by focusing submit button" }
    ],
    "assertions": [
      { "type": "hidden", "target": "emailError", "expected": null, "note": "no validation error for a syntactically valid email" },
      { "type": "attribute", "target": "emailInput", "attribute": "aria-invalid", "expected": "false" },
      { "type": "visible", "target": "submitButton", "expected": null, "note": "still on step=email" }
    ]
  },
  {
    "id": "TC-CDP-FP-004",
    "storyId": "forgot-password",
    "title": "提交合法邮箱本地推进到 confirm 步骤（不点击 Continue、不发送邮件）",
    "priority": "P1",
    "source": "cdp",
    "preconditions": ["导航到 /forgot-password，处于 step=email"],
    "setup": [{ "type": "navigate", "action": "navigate", "target": "/forgot-password" }],
    "teardown": [],
    "uiElements": [
      { "action": "fill", "target": "emailInput", "value": "qa.user@example.com", "locatorHint": "getByLabel('Email')", "dataType": "contact", "dataVariant": "valid-email" },
      { "action": "click", "target": "submitButton", "locatorHint": "getByRole('button', { name: 'Send Reset Link' })", "note": "onSubmit only setStep('confirm'); NO API call, NO email sent" }
    ],
    "assertions": [
      { "type": "visible", "target": "continueButton", "expected": null, "i18nKey": "auth.continueButton", "note": "confirm step reached" },
      { "type": "visible", "target": "returnToSignInButton", "expected": null, "i18nKey": "auth.returnToLogin" },
      { "type": "visible", "selector": "heading", "name": "Forgot Password", "expected": null, "i18nKey": "auth.forgotPasswordTitle", "note": "title persists in confirm step" }
    ],
    "guards": ["MUST NOT click Continue — it triggers authClient.requestPasswordReset and sends a real email"]
  },
  {
    "id": "TC-CDP-FP-005",
    "storyId": "forgot-password",
    "title": "\"Back to Sign In\" 链接指向 /sign-in",
    "priority": "P2",
    "source": "cdp",
    "preconditions": ["导航到 /forgot-password"],
    "setup": [{ "type": "navigate", "action": "navigate", "target": "/forgot-password" }],
    "teardown": [],
    "uiElements": [
      { "action": "locate", "target": "backToSignInLink", "locatorHint": "getByRole('link', { name: 'Back to Sign In' })" }
    ],
    "assertions": [
      { "type": "visible", "target": "backToSignInLink", "expected": null },
      { "type": "attribute", "target": "backToSignInLink", "attribute": "href", "expected": "/sign-in", "matcher": "endsWith" }
    ]
  }
]
