node_modules/
.specstory
tests/reports/
.claude/settings.local.json
playwright-report/
*reports/

# Env files (contain credentials)
.env

# MCP server config (contains hardcoded API keys/secrets)
.mcp.json

# Playwright auth state (contains session tokens)
playwright/.auth/
.auth/

# Test execution artifacts (screenshots, traces, videos)
test-results/
screenshots/

# 白盒测试运行时产物（每次 /qa-whitebox 跑不同目标都会生成一个目录，
# 内含 classification.json / vitest.whitebox.config.ts / vitest-run.log / coverage 等，
# 属于本地执行结果，不应提交；demo-mcp 是随 skill 一起维护的示例夹具，保留）
tests/whitebox/*/
!tests/whitebox/demo-mcp/

# Bug submit skill runtime state (last project/assignee cache)
skills/bug-submit/state/*.json

# tests/e2e/local — superseded by mira-test/miraday envs, only 1 stale spec,
# unmaintained since 2026-07-07. Still git-tracked for now; scheduled for
# `git rm -r` as a follow-up. Ignored here so nothing new gets added to it meanwhile.
tests/e2e/local/

# AI-generated test case docs & Excel exports (derived output, not source —
# regenerable from test-cases/generated/*.json handoff + baseline data, which
# stays tracked). Per CLAUDE.md naming convention: test-cases/generated/*.md,
# test-cases/excel/*.xlsx. `**/` prefix is required — each qa-platform project
# lives nested under tests/e2e/<project>/, and a bare "test-cases/..." pattern
# only anchors to the repo root, not to every nested project directory.
**/test-cases/generated/*.md
**/test-cases/excel/*.xlsx

# OS / IDE
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
*.code-workspace